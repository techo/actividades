APP_NAME=Actividades
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_LOG_LEVEL=debug
APP_URL=http://localhost:8000
SESSION_DOMAIN=localhost
APP_PAIS_DEFAULT=13
LOCALE=es_AR
APP_AVAILABLE_LOCALES="es_AR|ES, pt|PT, en|EN, es_CH|ES"

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
# En producción dejar en true (cookie solo por HTTPS). En dev local (HTTP) va en false.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database

MAIL_DRIVER=log
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=

APPLE_CLIENT_ID=

ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# App ID exclusiva para entornos local/staging. Si no se define, se usa ONESIGNAL_APP_ID como fallback.
# Recomendado: crear una app separada en OneSignal para dev para evitar notificaciones a usuarios reales.
ONESIGNAL_APP_ID_DEV=

PAYU_ENDPOINT=
PAYU_TEST=true

# Salesforce — exención de pago por socio/donante (solo Argentina, país 13).
# Apagado por defecto: sin SALESFORCE_ENABLED=true nadie queda exento (fail-closed).
SALESFORCE_ENABLED=false
# Client Credentials va al My Domain (*.my.salesforce.com), NO al dominio Lightning.
SALESFORCE_TOKEN_URL=https://techo.my.salesforce.com/services/oauth2/token
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=v61.0
SALESFORCE_TIMEOUT=5
SALESFORCE_SOCIO_PAIS_ID=13
SALESFORCE_CACHE_TTL=720

SENTRY_LARAVEL_DSN=
USERREPORT_TOKEN=
GOOGLE_ANALYTICS_TOKEN=

APP_DOCS=https://github.com/techo/voluntariado-eventual/wiki

APP_STORE_IOS_URL=https://apps.apple.com/mx/app/mitecho/id6758111110
APP_STORE_ANDROID_URL=https://play.google.com/store/apps/details?id=com.techoapp.mitecho&hl=es

APP_DEEP_LINK_URL=
